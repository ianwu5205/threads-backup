THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional. Defaults to 8787.
PORT=8787

# Optional. Leave blank to let the CLI create a Quick Tunnel.
# A fixed URL must already forward to http://127.0.0.1:PORT.
# THREADS_REDIRECT_URI=https://threads-backup.example.com/oauth/callback
# CLOUDFLARED_TUNNEL=threads-backup
