{
  "name": "threads-backup",
  "version": "0.1.2",
  "description": "Back up your Threads posts and media with the official Threads API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianwu5205/threads-backup.git"
  },
  "homepage": "https://github.com/ianwu5205/threads-backup#readme",
  "bugs": {
    "url": "https://github.com/ianwu5205/threads-backup/issues"
  },
  "type": "module",
  "bin": {
    "threads-backup": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepack": "pnpm check && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "threads",
    "backup",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
